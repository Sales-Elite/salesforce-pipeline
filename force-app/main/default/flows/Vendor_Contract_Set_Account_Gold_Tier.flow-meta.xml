<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <customErrors>
        <description>Fault path: tells the user which automation failed and why, instead of an unhandled-fault error.</description>
        <name>Fault_Handler</name>
        <label>Show why it failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Vendor Contract - Set Account Gold Tier could not finish, so this save was not completed. Reason: {!$Flow.FaultMessage} Ask your Salesforce admin if this keeps happening.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <environments>Default</environments>
    <interviewLabel>Vendor Contract - Set Account Gold Tier {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Vendor Contract - Set Account Gold Tier</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account_Tier</name>
        <label>Update Account Tier</label>
        <locationX>176</locationX>
        <locationY>734</locationY>
        <faultConnector>
            <targetReference>Fault_Handler</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Contract_Tier__c</field>
            <value>
                <stringValue>Gold</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account_Tier</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Contract_Value__c} &gt; 100000, NOT(ISBLANK({!$Record.Account__c})))</filterFormula>
        <object>Vendor_Contract__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
