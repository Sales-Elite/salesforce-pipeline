<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <customErrors>
        <description>Fault path: tells the user which automation failed and why, instead of an unhandled-fault error.</description>
        <name>Fault_Handler</name>
        <label>Show why it failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>N2 High Value Web Lead could not finish, so this save was not completed. Reason: {!$Flow.FaultMessage} Ask your Salesforce admin if this keeps happening.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Owner_Is_Queue</name>
        <label>Owner Is Queue</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Create_Task_For_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Owner is user</defaultConnectorLabel>
        <rules>
            <name>Queue_Owned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OwnerIsQueue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_For_Creator</targetReference>
            </connector>
            <label>Queue Owned</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DueDatePlus2</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>OwnerIsQueue</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!$Record.OwnerId}, 3) = &apos;00G&apos;</expression>
    </formulas>
    <interviewLabel>N2 High Value Web Lead {!$Flow.CurrentDateTime}</interviewLabel>
