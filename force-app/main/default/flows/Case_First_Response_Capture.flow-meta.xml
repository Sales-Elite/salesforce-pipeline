<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <customErrors>
        <description>Fault path: tells the user which automation failed and why, instead of an unhandled-fault error.</description>
        <name>Fault_Handler</name>
        <label>Show why it failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Case First Response Capture could not finish, so this save was not completed. Reason: {!$Flow.FaultMessage} Ask your Salesforce admin if this keeps happening.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <environments>Default</environments>
    <formulas>
        <name>formula_ResponseDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!$Record.MessageDate}), NOW(), {!$Record.MessageDate})</expression>
    </formulas>
    <interviewLabel>Case First Response Capture {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case First Response Capture</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Case_First_Response</name>
        <label>Update Case First Response</label>
        <locationX>176</locationX>
        <locationY>734</locationY>
        <faultConnector>
            <targetReference>Fault_Handler</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>First_Response_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>First_Response_Date__c</field>
            <value>
                <elementReference>formula_ResponseDate</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Case_First_Response</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Incoming} = false, NOT(ISBLANK({!$Record.ParentId})), BEGINS({!$Record.ParentId}, &apos;500&apos;))</filterFormula>
        <object>EmailMessage</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
