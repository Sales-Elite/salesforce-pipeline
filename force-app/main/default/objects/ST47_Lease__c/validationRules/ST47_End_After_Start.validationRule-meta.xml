<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ST47_End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(ST47_Start_Date__c)) &amp;&amp; NOT(ISBLANK(ST47_End_Date__c)) &amp;&amp; ST47_End_Date__c &lt;= ST47_Start_Date__c</errorConditionFormula>
    <errorDisplayField>ST47_End_Date__c</errorDisplayField>
    <errorMessage>End date must be after Start date.</errorMessage>
</ValidationRule>
