<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ST47_Monthly_Payment_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(ST47_Monthly_Payment__c)) &amp;&amp; ST47_Monthly_Payment__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>ST47_Monthly_Payment__c</errorDisplayField>
    <errorMessage>Monthly Payment must be greater than 0.</errorMessage>
</ValidationRule>
