<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_Justification_Min_Length</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Discount_Percent__c &gt; 0.15, LEN(Discount_Justification__c) &lt; 50 )</errorConditionFormula>
    <errorDisplayField>Discount_Justification__c</errorDisplayField>
    <errorMessage>Discount Justification must be at least 50 characters when Discount Percent is greater than 15%.</errorMessage>
</ValidationRule>
