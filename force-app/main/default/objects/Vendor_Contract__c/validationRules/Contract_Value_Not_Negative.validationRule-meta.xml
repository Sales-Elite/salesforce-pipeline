<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contract_Value_Not_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Contract_Value__c)), Contract_Value__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Contract_Value__c</errorDisplayField>
    <errorMessage>Contract value cannot be negative.</errorMessage>
</ValidationRule>
