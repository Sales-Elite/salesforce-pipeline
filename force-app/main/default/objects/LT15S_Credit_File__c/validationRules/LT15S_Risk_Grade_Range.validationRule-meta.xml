<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT15S_Risk_Grade_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(LT15S_Risk_Grade__c)), OR(LT15S_Risk_Grade__c &lt; 1, LT15S_Risk_Grade__c &gt; 10))</errorConditionFormula>
    <errorDisplayField>LT15S_Risk_Grade__c</errorDisplayField>
    <errorMessage>Risk Grade must be between 1 and 10.</errorMessage>
</ValidationRule>
