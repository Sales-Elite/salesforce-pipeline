<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FILM_A_Gold_Requires_Phone</fullName>
    <active>true</active>
    <description>Gold-tier accounts must have a phone number.</description>
    <errorConditionFormula>AND(ISPICKVAL(FILM_A_Tier__c, &quot;Gold&quot;), ISBLANK(Phone))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Gold accounts must have a phone number.</errorMessage>
</ValidationRule>
